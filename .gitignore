# Byte-compiled / cached files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
.env

# Local model and compiler caches
.hf-cache/
.torchinductor-cache/

# Editors / IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs / runtime artifacts
*.log
nohup.log
run_example.log
outputs/
runs/
leaderboard/

# Jupyter / notebooks
.ipynb_checkpoints/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Downloaded model weights (see README: FireRedVAD Stream-VAD goes here)
checkpoints/

# Prebuilt llama.cpp artifacts shipped with the r2t2_llama package. These are
# release products, not build leftovers, so they override the `*.so` rule above.
# See r2t2_llama/README.md for the pinned llama.cpp version.
!r2t2_llama/native/*.so
!r2t2_llama/bin/*.so
!r2t2_llama/bin/*.so.*
